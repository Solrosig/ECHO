# Template for .env — copy to `.env` and fill in the paths for this machine.
# config.py reads .env at import; a real environment variable overrides it.

# --- ZipVoice ---------------------------------------------------------------
# Interpreter of ZipVoice's own virtual environment (it pins torch 2.5.1).
ECHO_ZIPVOICE_PYTHON=C:\path\to\ZipVoice\.venv\Scripts\python.exe
# The ZipVoice checkout. Required: it ships no setup.py, so pip never installs the
# package and the folder has to go on PYTHONPATH.
ECHO_ZIPVOICE_REPO=C:\path\to\ZipVoice
# Local model + vocoder folders, needed only when the Hugging Face hub is unreachable.
# The vocoder is a SEPARATE repo (charactr/vocos-mel-24khz), so both are required.
ECHO_ZIPVOICE_MODEL_DIR=zv_model
ECHO_ZIPVOICE_VOCODER=zv_vocoder
# refs_ravdess = raw references; refs_ravdess_matched = level-matched (make_matched_refs.py)
ECHO_ZIPVOICE_REFS=refs_ravdess_matched
# Flow matching is stochastic; the seed is pinned and recorded (check_zipvoice.py proves it).
ECHO_ZIPVOICE_SEED=666
# 0.1 is ZipVoice's default prompt RMS normalisation; 0 disables it.
ECHO_ZIPVOICE_TARGET_RMS=0.1

# --- Engines that ship as repositories (StyleTTS 2, CosyVoice 2, Parler-TTS) ---
# The CLI is a TEMPLATE, because research repos change their invocation between commits.
# Placeholders: {python} {text} {out} {ref_wav} {instruction} {speed} {seed} {model_dir} {quadrant}
# Quote any placeholder whose value contains spaces: "{text}" "{instruction}"
# Fill each one in after the engine installs and its actual CLI is confirmed.

ECHO_STYLETTS2_PYTHON=C:\path\to\StyleTTS2\.venv\Scripts\python.exe
ECHO_STYLETTS2_REPO=C:\path\to\StyleTTS2
ECHO_STYLETTS2_MODEL_DIR=st2_model
ECHO_STYLETTS2_REFS=refs_ravdess_matched
# Leave CMD blank to use the bundled runner default (recommended).
# Override only if the upstream API moves and runners/ is edited.
#ECHO_STYLETTS2_CMD=

ECHO_COSYVOICE2_PYTHON=C:\path\to\CosyVoice\.venv\Scripts\python.exe
ECHO_COSYVOICE2_REPO=C:\path\to\CosyVoice
ECHO_COSYVOICE2_MODEL_DIR=cv2_model
ECHO_COSYVOICE2_REFS=refs_ravdess_matched
#ECHO_COSYVOICE2_CMD=

ECHO_PARLERTTS_PYTHON=C:\path\to\parler-tts\.venv\Scripts\python.exe
ECHO_PARLERTTS_REPO=C:\path\to\parler-tts
ECHO_PARLERTTS_MODEL_DIR=parler_model
#ECHO_PARLERTTS_CMD=

# Seed for every stochastic engine; recorded per clip (T0.3).
ECHO_ENGINE_SEED=666
