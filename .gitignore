# Machine-specific settings (paths differ per machine). .env.example IS committed.
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ECHO artifacts
*.db
*.wav
audio_out/

# Model files (downloaded, never committed — hundreds of MB; GitHub rejects >100 MB)
*.onnx
*.bin
*.safetensors
*.pt
*.pth
# local model folders, browser-downloaded when the HF download is blocked
# (emotion_conveyance.py --model ser_model ; ECHO_CHATTERBOX_MODEL=cb_model)
# NOTE: .gitignore does NOT support trailing comments on a pattern line —
# the comment must be on its own line or the whole line becomes the pattern.
ser_model/
cb_model/
zv_model/
zv_vocoder/
st2_model/
cv2_model/
parler_model/
refs/
refs_ravdess/
# derived from refs_ravdess by make_matched_refs.py — regenerate, never commit.
# Without this line the .txt transcripts would be committed while their .wav files stay
# ignored, leaving a half-recorded reference set in the repository.
refs_ravdess_matched/
RAVDESS/
Audio_Speech_Actors_01-24/

# Reference copy of the pre-built code (kept, not tracked)
_reference/

# OS / editor
.DS_Store
.vscode/
text_model/ 

# ---- ECHO standalone 1.5.0 ----
# Binaries and generated files come from the release asset, never from git.
standalone/dist/
standalone/node_modules/
standalone/thesis/
standalone/README.html
standalone/docs/archive/*.html
standalone/research-bundle/README.html
standalone/docs/listener-instructions-v2/*.docx
standalone/public/models/**/*.wasm
standalone/public/models/qwen/tokenizer.json
standalone/public/models/qwen/vocab.json
standalone/public/models/qwen/merges.txt
standalone/public/models/kokoro/onnx/
standalone/public/models/kokoro/voices/
standalone/public/models/piper/
standalone/public/vendor/espeak/
standalone/public/vendor/piper/
standalone/public/vendor/ort/
standalone/public/vendor/**/*.wasm
standalone/public/vendor/**/*.data
standalone/public/upstream/
standalone/public/calibration/audio/
standalone/espeak-client.js
standalone/piper.worker.js
standalone/piper-phonemize.js
standalone/vendor/soundtouch/**/*.map
standalone/vendor/soundtouch/**/*.tsbuildinfo
standalone/**/*.zip
standalone/space-upload/
standalone/research-bundle/full-acoustic/audio/diagnostics/
standalone/research-bundle/full-acoustic/audio/reference/
standalone/research-bundle/current-phase/kokoro-ablation/raw/*.f32
# Frozen research audio that IS versioned; the root *.wav rule would hide it. Hashes pinned in PROTOCOL_FREEZE_V2.json.
!standalone/public/study/audio/*.wav
!standalone/research-bundle/current-phase/kokoro-ablation/processed/*.wav
!standalone/research-bundle/full-acoustic/audio/primary/*.wav
!standalone/research-bundle/full-acoustic/audio/development/*.wav
# tts-service/refs holds committed metadata; the root "refs/" rule would hide the folder. Its WAVs stay ignored by *.wav.
!standalone/tts-service/refs/

# WebLLM model bundle: kept out of the repository (not part of the frontend)
standalone/public/models/qwen/
