[Unit]
Description=ECHO standalone academic prototype
After=network.target

[Service]
Type=simple
User=echo
Group=echo
WorkingDirectory=/opt/echo
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=ECHO_DATA_DIR=/var/lib/echo
EnvironmentFile=/etc/echo.env
ExecStart=/usr/bin/node /opt/echo/server/start.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/echo

[Install]
WantedBy=multi-user.target
